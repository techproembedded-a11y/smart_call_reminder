# ==============================================================================
# SMART CALL REMINDER — BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database Connection
DATABASE_URL=sqlite:///./smart_call_reminder.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@smartcallreminder.local

# Speech-to-Text Provider (Groq Whisper, OpenAI Whisper, or manual fallback)
TRANSCRIPTION_PROVIDER=auto
GROQ_API_KEY=
OPENAI_API_KEY=

# Audio Retention (False = delete immediately after transcription)
RETAIN_AUDIO_FILES=false
UPLOAD_DIR=./uploads

# Default Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
