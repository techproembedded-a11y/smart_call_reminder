# ==============================================================================
# SMART CALL REMINDER — ROOT ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (SQLite for local dev, PostgreSQL for production)
# Local SQLite: sqlite:///./smart_call_reminder.db
# Production PostgreSQL: postgresql://postgres:password@localhost:5432/smart_call_reminder
DATABASE_URL=sqlite:///./smart_call_reminder.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# VAPID Web Push Notification Keys
# Generate new keys using: npx web-push generate-vapid-keys OR python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@smartcallreminder.local

# Speech-to-Text (STT) Provider Configuration
# Supported: "groq", "openai", "none" (manual entry with smart fallback)
TRANSCRIPTION_PROVIDER=auto
GROQ_API_KEY=
OPENAI_API_KEY=

# Privacy & Storage Settings
# When false, temporary audio recordings are deleted immediately after transcription
RETAIN_AUDIO_FILES=false
UPLOAD_DIR=./uploads

# Default Local Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
